# Mesh signaling + static (Express)
MESH_PORT=3000

# SFU token API + static (Express)
SFU_PORT=3001

# Vite React clients (dev)
MESH_VITE_PORT=5173
SFU_VITE_PORT=5174

# LiveKit SFU (dev defaults from `livekit-server --dev`)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Optional: path used by automation / matrix later
RESULTS_DIR=results
